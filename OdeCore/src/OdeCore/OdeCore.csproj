<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SQLite is called through LibraryImport, whose generated stubs are unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Storage tests read and fault the session file through the core's own
         connection, and history tests walk visits against a small history limit. -->
    <InternalsVisibleTo Include="OdeCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The written answers the palette shows for how-to questions. -->
    <EmbeddedResource Include="Domain/Answers/answers.json" LogicalName="OdeCore.Answers.json" />
  </ItemGroup>
</Project>
